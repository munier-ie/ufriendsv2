# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/ufriendsv2?schema=public"

# Runtime
# Backend runtime mode. NODE_ENV supplied by PM2/systemd still takes precedence.
API_NODE_ENV="production"
PORT=3000

# Authentication
# Generate: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-unique-128-character-hex-secret"

# Security (CRITICAL)
ENCRYPTION_KEY="replace-with-an-exactly-32-character-secret"

# Reverse proxy
# Leave empty only when clients connect directly to Node.
# For Nginx on this same VPS proxying to 127.0.0.1/localhost, use "loopback".
# For an external load balancer, use only its exact IP/CIDR values, comma-separated.
# Never use "true", "*", or an unrestricted trust value.
TRUSTED_PROXY_ADDRESSES="loopback"
# Optional comma-separated first-party browser origins beyond FRONTEND_URL.
# Example: CORS_ALLOWED_ORIGINS="https://staging.ufriends.com.ng"
CORS_ALLOWED_ORIGINS=""
# Enable only if the trusted ingress overwrites (does not merely forward)
# cf-ipcity/cf-region/cf-ipcountry headers.
TRUST_GEO_HEADERS="false"

# Redis and distributed rate limiting
# Use one shared, private Redis instance for every PM2/API process.
# Add authentication in production; do not expose Redis port 6379 publicly.
REDIS_URL="redis://:replace-with-redis-password@127.0.0.1:6379/0"
# Generate independently from JWT_SECRET:
# node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
RATE_LIMIT_KEY_SECRET="replace-with-a-different-128-character-hex-secret"
# Do not set RATE_LIMIT_STORE=memory in production. Memory mode is per-process.

# Rate-limit overrides (positive integers; defaults shown)
# General /api traffic: requests per 60 seconds
RATE_LIMIT_API_IP=1200
RATE_LIMIT_API_DEVICE=300
# User login: attempts per 15 minutes
RATE_LIMIT_LOGIN_IP=30
RATE_LIMIT_LOGIN_DEVICE=10
RATE_LIMIT_LOGIN_ACCOUNT=10
# Failed credentials: lock on the 3rd failure, then 1m, 5m, and 15m.
RATE_LIMIT_LOGIN_FAILURES=3
RATE_LIMIT_LOGIN_BACKOFF_SECONDS="60,300,900"
# Admin login: attempts per 30 minutes
RATE_LIMIT_ADMIN_LOGIN_IP=5
RATE_LIMIT_ADMIN_LOGIN_DEVICE=5
RATE_LIMIT_ADMIN_LOGIN_ACCOUNT=5
# Admin failed credentials: lock on the 3rd failure, then 5m, 15m, and 30m.
RATE_LIMIT_ADMIN_LOGIN_FAILURES=3
RATE_LIMIT_ADMIN_LOGIN_BACKOFF_SECONDS="300,900,1800"
# Signup: attempts per hour
RATE_LIMIT_SIGNUP_IP=5
RATE_LIMIT_SIGNUP_DEVICE=3
RATE_LIMIT_SIGNUP_ACCOUNT=3
# Email/TOTP verification: attempts per 10 minutes (15-minute block)
RATE_LIMIT_OTP_IP=5
RATE_LIMIT_OTP_DEVICE=5
RATE_LIMIT_OTP_ACCOUNT=5
# Password recovery: attempts per hour
RATE_LIMIT_RECOVERY_IP=5
RATE_LIMIT_RECOVERY_DEVICE=5
RATE_LIMIT_RECOVERY_ACCOUNT=5
# Sensitive service/transfer/bulk actions: requests per 60 seconds
RATE_LIMIT_ACTION_IP=120
RATE_LIMIT_ACTION_DEVICE=30
# Transaction PIN: lock on the 3rd incorrect PIN, then 1m, 5m, and 15m.
RATE_LIMIT_PIN_FAILURES=3
RATE_LIMIT_PIN_BACKOFF_SECONDS="60,300,900"

# Monnify (Virtual Accounts)
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_BASE_URL="https://api.monnify.com"
MONNIFY_STATUS="Off" # On/Off

# PaymentPoint (Virtual Accounts alternative)
PAYMENTPOINT_API_KEY=""
PAYMENTPOINT_SECRET_KEY=""
PAYMENTPOINT_BUSINESS_ID=""
PAYMENTPOINT_BASE_URL="https://api.paymentpoint.co"
PAYMENTPOINT_STATUS="Off"

# Paystack
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_STATUS="Off"
EMAIL_FROM='"Ufriends Support" <support@ufriends.com>'
ADMIN_EMAIL="admin@ufriends.com"

# External URLs
FRONTEND_URL="https://ufriends.com.ng"

# Cloudflare R2 (Slip PDF Storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ufriends-slips"

# Puppeteer (PDF Generation)
# CHROME_BIN="/usr/bin/google-chrome" # Uncomment and set if needed
